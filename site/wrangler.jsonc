{
  // Worker de Cloudflare que sirve los assets estáticos del sitio.
  // El nombre debe coincidir con el del proyecto en el dashboard.
  "name": "fronteando",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./dist",
  },
  // Requerido por `wrangler preview`, el comando de deploy de las
  // builds de preview de Workers Builds.
  "previews": {},
  // Publica cada preview en <preview>-fronteando.gilmrjc.workers.dev.
  "preview_urls": true,
  // Producción se sirve en el dominio propio de la zona fronteando.dev,
  // tanto en el apex como en www.
  "routes": [
    {
      "pattern": "fronteando.dev",
      "zone_name": "fronteando.dev",
      "custom_domain": true,
    },
    {
      "pattern": "www.fronteando.dev",
      "zone_name": "fronteando.dev",
      "custom_domain": true,
    },
  ],
}
