---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import AccompanimentCard from "../../components/AccompanimentCard.astro";
import { formatFecha } from "../../utils/format";
import { protocolOf } from "../../utils/accompaniment";

export async function getStaticPaths() {
  const articulos = await getCollection("articulos", ({ data }) => !data.draft);
  return articulos.map((articulo) => ({
    params: { id: articulo.id },
    props: { articulo },
  }));
}

interface Props {
  articulo: CollectionEntry<"articulos">;
}

const { articulo } = Astro.props;
const { Content } = await render(articulo);
const fecha = formatFecha(articulo.data.date);
const ogImagePath = `/og/${articulo.id}.png`;
const markdownPath = `/articulos/${articulo.id}.md`;
const protocol = protocolOf(articulo);
---

<Base
  title={`${articulo.data.title} — Fronteando`}
  description={articulo.data.description}
  type="article"
  image={ogImagePath}
  alternateMarkdown={markdownPath}
>
  <article class:list={["prose", { "has-rail": protocol }]}>
    <h1>{articulo.data.title}</h1>
    <p class="article-meta">
      <time datetime={articulo.data.date.toISOString().slice(0, 10)}>
        {fecha}
      </time>
      {articulo.data.tags.length > 0 && ` · ${articulo.data.tags.join(", ")}`}
    </p>
    <p class="article-meta article-meta-struct">
      {articulo.data.nivel && `nivel: ${articulo.data.nivel} · `}pilar:{" "}
      {articulo.data.categoria} · texto plano:{" "}
      <a href={markdownPath}>markdown</a>
    </p>
    {protocol && (
      <div class="article-rail">
        <AccompanimentCard protocol={protocol} />
      </div>
    )}
    <div class="article-content">
      <Content />
    </div>
  </article>
</Base>
