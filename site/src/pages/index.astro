---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { excerptOf } from "../utils/excerpt";
import { formatFecha } from "../utils/format";

const articulos = (
  await getCollection("articulos", ({ data }) => !data.draft)
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base
  title="Fronteando"
  description="Blog técnico de desarrollo web frontend, escrito en español: un lugar donde aprenderlo, con o sin asistente de por medio."
>
  <div class="prose">
    <h1>Fronteando</h1>
  </div>
  {articulos.length === 0 ? (
    <p class="article-empty">Aún no hay artículos publicados.</p>
  ) : (
    <ul class="article-list" role="list">
      {articulos.map((articulo) => (
        <li class="article-list-item">
          <a class="article-list-link" href={`/articulos/${articulo.id}/`}>
            {articulo.data.title}
          </a>
          <p class="article-meta">
            <time datetime={articulo.data.date.toISOString().slice(0, 10)}>
              {formatFecha(articulo.data.date)}
            </time>
            {articulo.data.nivel && (
              <span class="meta-chip">{articulo.data.nivel}</span>
            )}
            <span class="meta-chip">{articulo.data.categoria}</span>
          </p>
          <p class="article-excerpt">
            {excerptOf(articulo.body ?? "") || articulo.data.description}
          </p>
        </li>
      ))}
    </ul>
  )}
</Base>
